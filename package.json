{
  "name": "node-lint-stack",
  "version": "1.2.0",
  "private": true,
  "description": "Install Biome + ESLint (Sonar parity) + React Compiler marker + Stylelint into any Node project",
  "type": "module",
  "bin": {
    "node-lint-stack": "./bin/install.mjs"
  },
  "files": [
    "bin/install.mjs",
    "bin/pick-layers.mjs",
    "template/.lint-stack.json",
    "template/.npmrc",
    "template/biome.json",
    "template/biome.next-snippet.json",
    "template/eslint.config.mjs",
    "template/eslint.sonar-extended.mjs",
    "template/scripts/lint.mjs",
    "template/stylelint.config.mjs",
    "template/stylelint.sonar-contrast.mjs",
    "stack.manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
